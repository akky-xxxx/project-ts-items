# website-upload(bun upload:website)で Vercel Blob にアップロードするためのトークン
# 選んだ環境の変数だけ必須。Vercel の各 Blob ストアの設定画面で Read/Write トークンを発行し、Infisical の環境 local のフォルダ /workspaces/feature-flags に登録する
# bun upload:website は infisical run で実行時に注入するため、.env.local には書かない
BLOB_READ_WRITE_TOKEN_PRD=
BLOB_READ_WRITE_TOKEN_STG=
