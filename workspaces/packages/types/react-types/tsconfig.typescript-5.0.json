{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleDetection": "force",
    "types": [],
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": false,
    "paths": {
      "react": ["./node_modules/@types/react-18"]
    }
  },
  "files": ["./compatibility/typescript-5.0/index.ts"]
}
