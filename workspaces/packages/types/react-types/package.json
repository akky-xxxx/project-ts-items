{
  "name": "@ts-items/react-types",
  "version": "0.0.1",
  "description": "General-purpose React types not provided by @types/react",
  "homepage": "https://github.com/akky-xxxx/project-ts-items/tree/main/workspaces/packages/types/react-types#readme",
  "bugs": {
    "url": "https://github.com/akky-xxxx/project-ts-items/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akky-xxxx/project-ts-items.git",
    "directory": "workspaces/packages/types/react-types"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-code": "run-s test lint -c",
    "fix": "run-p fix:* -c --aggregate-output",
    "fix:oxfmt": "oxfmt -c ./oxfmt.config.mts",
    "fix:oxlint": "bun lint:oxlint --fix",
    "fix:sort-package-json": "sort-package-json",
    "lint": "run-p lint:* -c --aggregate-output",
    "lint:cspell": "cspell lint \"**\" --no-progress",
    "lint:knip": "knip -c knip.config.mts",
    "lint:oxfmt": "bun fix:oxfmt --check",
    "lint:oxlint": "oxlint -c ./oxlint.config.mts --deny-warnings --report-unused-disable-directives --format=stylish",
    "lint:sort-package-json": "bun fix:sort-package-json --check",
    "lint:type-check": "bun check",
    "prepublishOnly": "bun run build",
    "test": "run-s build test:* -c",
    "test:react-18": "bun check -p tsconfig.react-18.json",
    "test:react-19": "bun check -p tsconfig.json",
    "test:typescript-5.0": "bun node_modules/typescript-5.0/bin/tsc -p tsconfig.typescript-5.0.json"
  },
  "devDependencies": {
    "@ts-items/configurations": "workspace:*",
    "@ts-items/oxfmt-config": "workspace:*",
    "@ts-items/oxlint-config": "workspace:*",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-18": "npm:@types/react@18.3.31",
    "cspell": "10.4.0",
    "knip": "6.43.0",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "sort-package-json": "4.1.0",
    "typescript": "6.0.3",
    "typescript-5.0": "npm:typescript@5.0.4"
  },
  "peerDependencies": {
    "@types/react": ">=18.0.0",
    "typescript": ">=5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
