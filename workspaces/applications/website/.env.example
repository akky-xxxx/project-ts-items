# 外部 API を msw のモックに向けるか(任意)。enabled ならモックに向ける。next dev のときだけ有効
API_MOCKING=
# npm Registry API のリクエスト先(任意)。未設定なら https://registry.npmjs.org
# next dev / next start の起動時に読む。ローカルのミラー(例: http://localhost:4873)などに向けるときに設定する
NPM_REGISTRY_BASE_URL=

# feature flag の json の参照先(必須)。未設定の場合は全ての feature flag を無効として扱う
# ローカル: @ts-items/feature-flags の bun gen:website-local で生成した json へのパス(website からの相対パス)
# stg / prd: json をアップロードした Vercel Blob ストアの base URL(https://〜。Blob ストアの設定画面で確認する)
FEATURE_FLAG_URL=../../feature-flags/featureFlag.json
