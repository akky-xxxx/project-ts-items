{
  "name": "website",
  "private": true,
  "type": "module",
  "scripts": {
    "build-storybook": "storybook build",
    "check-code": "run-s -c lint test",
    "dev": "run-p \"dev:*\" -c --aggregate-output",
    "dev:hcm": "bun prepare:hcm -w",
    "dev:next": "next dev",
    "dev:storybook": "bun storybook",
    "fix": "run-s -c fix:stylelint fix:sort-package-json fix:oxlint fix:oxfmt",
    "fix:oxfmt": "oxfmt -c ./oxfmt.config.mts",
    "fix:oxlint": "bun lint:oxlint --fix",
    "fix:sort-package-json": "sort-package-json",
    "fix:stylelint": "bun lint:stylelint --fix",
    "lint": "npm-run-all -s prepare:typegen prepare:orval -p \"lint:*\" -c --aggregate-output",
    "lint:cspell": "cspell lint \"**\" --no-progress",
    "lint:knip": "knip -c knip.config.mts",
    "lint:oxfmt": "bun fix:oxfmt --check",
    "lint:oxlint": "oxlint -c ./oxlint.config.mts --deny-warnings --report-unused-disable-directives --format=stylish",
    "lint:sort-package-json": "bun fix:sort-package-json --check",
    "lint:stylelint": "stylelint --max-warnings 0 \"**/*.css\"",
    "lint:type-check": "bun check",
    "prepare": "run-p -c --aggregate-output \"prepare:*\"",
    "prepare:hcm": "hcm \"src/**/*.module.css\"",
    "prepare:orval": "orval --config ./orval.config.mts",
    "prepare:typegen": "next typegen",
    "storybook": "storybook dev -p 3100",
    "test": "run-s prepare:orval test:vitest",
    "test:vitest": "vitest run"
  },
  "dependencies": {
    "@ts-items/feature-flags": "workspace:*",
    "flat": "6.0.1",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hot-toast": "2.6.1",
    "server-only": "0.0.1",
    "shiki": "4.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.6.0",
    "@csstools/postcss-global-data": "4.0.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-mcp": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/nextjs-vite": "10.6.7",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@ts-items/configurations": "workspace:*",
    "@ts-items/oxfmt-config": "workspace:*",
    "@ts-items/oxlint-config": "workspace:*",
    "@ts-items/react-types": "workspace:*",
    "@tsconfig/next": "2.0.7",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "cspell": "10.5.1",
    "happy-css-modules": "5.0.2",
    "happy-dom": "21.0.4",
    "knip": "6.45.1",
    "msw": "3.0.6",
    "msw-storybook-addon": "3.0.3",
    "npm-run-all2": "9.0.4",
    "orval": "8.48.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "playwright": "1.65.0",
    "postcss": "8.5.33",
    "postcss-custom-media": "12.0.4",
    "sort-package-json": "4.1.0",
    "storybook": "10.6.7",
    "stylelint": "18.0.0",
    "stylelint-config-alphabetical-order": "3.0.0",
    "stylelint-config-standard": "41.0.0",
    "stylelint-order": "8.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
