{
  "name": "website",
  "private": true,
  "type": "module",
  "scripts": {
    "build-storybook": "storybook build",
    "check-code": "run-s -c lint test",
    "dev": "run-p \"dev:*\" -c --aggregate-output",
    "dev:hcm": "bun prepare:hcm -w",
    "dev:next": "next dev",
    "dev:storybook": "bun storybook",
    "fix": "run-s -c fix:sort-package-json fix:oxlint fix:oxfmt",
    "fix:oxfmt": "oxfmt -c ./oxfmt.config.mts",
    "fix:oxlint": "bun lint:oxlint --fix",
    "fix:sort-package-json": "sort-package-json",
    "fix:stylelint": "bun lint:stylelint --fix",
    "lint": "npm-run-all -s prepare:typegen -p \"lint:*\" -c --aggregate-output",
    "lint:cspell": "cspell lint \"**\" --no-progress",
    "lint:knip": "knip -c knip.config.mts",
    "lint:oxfmt": "bun fix:oxfmt --check",
    "lint:oxlint": "oxlint -c ./oxlint.config.mts --deny-warnings --report-unused-disable-directives --format=stylish",
    "lint:sort-package-json": "bun fix:sort-package-json --check",
    "lint:stylelint": "stylelint --max-warnings 0 \"**/*.css\"",
    "lint:type-check": "bun check",
    "prepare": "run-p -c --aggregate-output \"prepare:*\"",
    "prepare:hcm": "hcm \"src/**/*.module.css\"",
    "prepare:typegen": "next typegen",
    "storybook": "storybook dev -p 3100",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-mcp": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@tsconfig/next": "2.0.6",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "cspell": "10.4.0",
    "happy-css-modules": "5.0.2",
    "knip": "6.43.0",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "playwright": "latest",
    "postcss": "8.5.32",
    "sort-package-json": "4.1.0",
    "storybook": "10.6.5",
    "stylelint": "17.16.0",
    "stylelint-config-alphabetical-order": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.2",
    "typescript": "6.0.3",
    "vite": "latest",
    "vitest": "latest"
  }
}
